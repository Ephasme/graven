{
  "name": "graven-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts && bun run scripts/verify-packaging.ts",
    "typecheck": "tsc --build --force",
    "test": "bunx --bun vitest run --project unit",
    "test:integration": "bunx --bun vitest run --project integration",
    "test:coverage": "bunx --bun vitest run --coverage",
    "test:watch": "bunx --bun vitest",
    "check": "bun run typecheck && bun run test",
    "check:all": "bun run typecheck && bun run build && bun run test && bun run test:integration",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "changeset": "changeset",
    "version": "changeset version && bun install",
    "release": "bun run scripts/publish.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3",
    "@types/bun": "^1.2.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@vitest/coverage-v8": "^5.0.0",
    "kysely": "^0.28.0",
    "mysql2": "^3.11.0",
    "pg": "^8.13.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "zod": "^4.0.0"
  }
}
